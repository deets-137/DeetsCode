{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeetsCode",
  "mainBinaryName": "DeetsCode",
  "version": "0.1.0",
  "identifier": "com.harness.app",
  "build": {
    "beforeDevCommand": "python server.py",
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeetsCode",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
