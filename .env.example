# Copy to .env (gitignored). Non-secret settings that aren't credentials or IDs
# belong in config.py instead — copy config.example.py for those.
#
# Every value here is optional except DISCORD_TOKEN, and only if you run the
# Discord bridge. The harness itself (server.py / the Tauri shell) needs none
# of it.

# ─── Discord bridge (discord_bot.py) ─────────────────────────────────────────
# Discord developer portal → your app → Bot → Reset Token. This is a *separate*
# bot application from DeetsOTD's — don't reuse that token here.
DISCORD_TOKEN=your_bot_token_here

# Guild to sync slash commands to. Guild-scoped sync is instant; global sync can
# take up to an hour. Auto-detected when the bot is in exactly one guild, so you
# only need this once it joins a second server.
# Developer mode on → right-click the server → Copy Server ID.
DISCORD_GUILD_ID=

# Channels where the bot answers every message, no @mention needed. Comma
# separated. Empty = mention-only everywhere.
# Developer mode on → right-click the channel → Copy Channel ID.
CHANNEL_IDS=

# Prompt mode the bridge opens sessions with — a filename in prompts/ minus the
# .md. DeetsCode is the only live mode today.
PROMPT_MODE=DeetsCode

# Apply AI-queued file writes without asking in Discord first. 1/true/yes/on.
AUTO_APPLY=true

# WebSocket URL of the running harness. Match config.py's HOST/PORT.
HARNESS_WS=ws://localhost:8000/ws

# llama-server root URL (no /v1), used only by the bot's /health command.
LLM_URL=http://localhost:8080

# ─── Future integrations ─────────────────────────────────────────────────────
# Keys for services the harness may pull from. Nothing in-tree reads these yet;
# they're here so the shape is settled before the panels that need them land.

# Notion internal integration token — https://www.notion.so/profile/integrations
NOTION_TOKEN=
