# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Config (has local URLs/settings — copy config.example.py instead)
config.py

# Secrets
.env

# Claude Code session data
.claude/

# Editor / IDE
.obsidian/
.vscode/
.idea/

# Runtime state
.harness/
task.md
friction.md
/campaign_state.json
/sessions/
/saves/
storage.db
storage.db-journal
storage.db-wal
storage.db-shm
active_model.txt

# `manual/` is project documentation and *is* tracked — only manual/task.md
# is ignored, and that's already covered by the `task.md` rule above (which
# matches at any depth). No `manual/` rule here on purpose; the earlier
# blanket-ignore was a leftover from the retired knowledge_packs UI.

# Archived dev notes (kept locally, not tracked)
docs/archive/

# OS
.DS_Store
Thumbs.db

# App runtime state (preserved across bundle updates, never committed)
apps/*/state/
apps/*.bak/
